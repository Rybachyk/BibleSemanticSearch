{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDB": {
    "DatabaseName": "BibleKnowledgeBase"
  },
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "Model": "openai/text-embedding-3-small",
    "Dimensions": 1536
  },
  "AllowedHosts": "*",
  "SearchSettings": {
    "ChunkSimilarityThreshold": 0.70,
    "VerseSimilarityThreshold": 0.65
  }
}
